# Copy to .env and fill in. .env is ignored by git; never commit a real key.
# Used only by scripts/check-sources.cjs --tinyfish
# Run: node --env-file=.env scripts/check-sources.cjs --tinyfish
TINYFISH_API_KEY=

# Used only by scripts/draft-lesson.cjs. Alternatively run `ant auth login` once and leave this empty.
# Every real draft is a paid API call; run with --dry-run first to see the size.
# Run: node --env-file=.env scripts/draft-lesson.cjs <company> --source <https link> --source <https link>
ANTHROPIC_API_KEY=
